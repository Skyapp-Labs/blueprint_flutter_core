{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Development",
            "request": "launch",
            "type": "dart",
            "program": "example/lib/main.dart",
            "flutterMode": "debug",
            "args": [
              "--dart-define", "FLAVOR=development"
            ]
        },
        {
            "name": "Icon Studio",
            "request": "launch",
            "type": "node-terminal",
            "command": "npm start",
            "cwd": "${workspaceFolder}/example/icon-studio"
        },
        {
            "name": "Production",
            "request": "launch",
            "type": "dart",
            "program": "example/lib/main.dart",
            "flutterMode": "release",
            "args": [
                "--dart-define", "FLAVOR=production"
            ]
        }
    ]
}
